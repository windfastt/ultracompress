{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ultracompress.dev/schemas/pipeline-recipe.schema.json",
  "title": "PipelineRecipe",
  "description": "Ordered compression pipeline (logical DSL).",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "steps"],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/pipelineStep" }
    },
    "verify": { "$ref": "#/$defs/verifyOptions" },
    "profile": {
      "type": "string",
      "enum": ["Balanced", "Small", "Tiny", "Laboratory", "Experimental"]
    }
  },
  "$defs": {
    "verifyOptions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "decompressRoundtrip": { "type": "boolean", "default": true },
        "hashOriginal": { "type": "boolean", "default": true }
      }
    },
    "pipelineStep": {
      "oneOf": [
        { "$ref": "#/$defs/preprocessStep" },
        { "$ref": "#/$defs/compressStep" }
      ]
    },
    "preprocessStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "name"],
      "properties": {
        "op": { "const": "preprocess" },
        "name": { "type": "string", "minLength": 1 },
        "params": {
          "type": "object",
          "additionalProperties": true,
          "default": {}
        }
      }
    },
    "compressStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "codec"],
      "properties": {
        "op": { "const": "compress" },
        "codec": {
          "type": "string",
          "minLength": 1,
          "enum": ["zstd", "7z", "xz", "brotli", "gzip", "deflate", "lzma", "custom"]
        },
        "level": { "type": "integer", "minimum": 0, "maximum": 22, "default": 3 },
        "dictSizeKb": { "type": ["integer", "null"], "minimum": 0 },
        "method": { "type": "string" },
        "solid": { "type": "boolean" },
        "threads": { "type": "integer", "minimum": 0, "description": "0 means auto / all cores" }
      }
    }
  }
}