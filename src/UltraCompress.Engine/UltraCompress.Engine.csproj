<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-UltraCompress.Engine-24a5b58f-31a2-459c-9a2b-5718b8868c24</UserSecretsId>
    <RootNamespace>UltraCompress.Engine</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="UltraCompress.Core.Tests" />
    <InternalsVisibleTo Include="UltraCompress.ArchiveEngine.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" Version="2.67.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Protos\engine_v1.proto" GrpcServices="Server" />
    <Protobuf Include="Protos\worker_v1.proto" GrpcServices="Server" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UltraCompress.Core\UltraCompress.Core.csproj" />
    <ProjectReference Include="..\UltraCompress.Worker\UltraCompress.Worker.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="CopyWorkerOutputs" AfterTargets="Build">
    <ItemGroup>
      <WorkerArtifacts Include="$(MSBuildThisFileDirectory)..\UltraCompress.Worker\bin\$(Configuration)\$(TargetFramework)\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(WorkerArtifacts)"
          DestinationFolder="$(OutputPath)%(RecursiveDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(MSBuildThisFileDirectory)..\UltraCompress.Worker\bin\$(Configuration)\$(TargetFramework)')" />
  </Target>
</Project>