{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Engine": {
    "GrpcPort": 17832,
    "DistributedWorkers": {
      "Enabled": false,
      "PreferRemoteWorkers": true,
      "FallbackToLocalProcess": true,
      "WorkerGrpcPort": 17833,
      "WorkerListenHost": "0.0.0.0",
      "LeaseTtlSeconds": 120,
      "HeartbeatIntervalSeconds": 30,
      "WorkerTokenFile": ""
    }
  }
}