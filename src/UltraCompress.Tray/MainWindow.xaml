<Window
    x:Class="UltraCompress.Tray.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tb="using:H.NotifyIcon">

    <Grid Padding="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="8">
            <TextBlock Text="UltraCompress queue" FontSize="20" FontWeight="SemiBold" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="ProfileBox" Grid.Column="0" SelectedIndex="0" HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="Balanced" />
                    <ComboBoxItem Content="Small" />
                    <ComboBoxItem Content="Tiny" />
                    <ComboBoxItem Content="Laboratory" />
                </ComboBox>
                <TextBox x:Name="PathBox" Grid.Column="1" PlaceholderText="File or folder path" />
                <Button x:Name="EnqueueButton" Grid.Column="2" Content="Enqueue" Click="OnEnqueue" />
            </Grid>
        </StackPanel>

        <ListView
            x:Name="JobList"
            Grid.Row="1"
            Margin="0,12,0,12"
            SelectionMode="Single"
            IsItemClickEnabled="True"
            ItemClick="OnJobItemClick">
            <ListView.HeaderTemplate>
                <DataTemplate>
                    <Grid Padding="0,4" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="80" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Path" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="Profile" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2" Text="State" FontWeight="SemiBold" />
                    </Grid>
                </DataTemplate>
            </ListView.HeaderTemplate>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:QueueJobDisplay" xmlns:local="using:UltraCompress.Tray">
                    <Grid ColumnSpacing="12" Padding="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="80" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{x:Bind Path}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="{x:Bind Profile}" />
                        <TextBlock Grid.Column="2" Text="{x:Bind State}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
            <Button Content="Refresh" Click="OnReconnect" />
            <Button Content="Pause all" Click="OnPauseAll" />
            <Button Content="Resume all" Click="OnResumeAll" />
            <Button Content="Cancel selected" Click="OnCancelSelected" />
        </StackPanel>

        <tb:TaskbarIcon
            x:Name="TrayIcon"
            IconSource="/Assets/TrayIcon.png"
            ToolTipText="UltraCompress — connecting…"
            MenuActivation="RightClick"
            LeftClickCommand="{x:Bind ShowQueueClickCommand}">
            <tb:TaskbarIcon.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Text="Open queue" Click="OnOpenQueue" />
                    <MenuFlyoutItem Text="Pause all jobs" Click="OnPauseAll" />
                    <MenuFlyoutItem Text="Resume all jobs" Click="OnResumeAll" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Reconnect to engine" Click="OnReconnect" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Exit" Click="OnExit" />
                </MenuFlyout>
            </tb:TaskbarIcon.ContextFlyout>
        </tb:TaskbarIcon>
    </Grid>
</Window>