<Window
    x:Class="UltraCompress.Tray.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tb="using:H.NotifyIcon"
    xmlns:local="using:UltraCompress.Tray">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Application Header Bar -->
        <Border
            Grid.Row="0"
            Padding="20,12"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <StackPanel Spacing="2">
                        <TextBlock Text="UltraCompress Desktop" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock
                            Text="Content-Aware Lossless Archive Manager &amp; Safety-Gated Data Studio"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Border
                        Padding="10,4"
                        VerticalAlignment="Center"
                        CornerRadius="12"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="#16A34A"
                        BorderThickness="1">
                        <TextBlock
                            Text="100% Bit-Exact Lossless Default · SHA-256 Verified"
                            FontSize="12"
                            FontWeight="SemiBold" />
                    </Border>
                </StackPanel>

                <TextBlock
                    x:Name="HeaderEngineStatusText"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Local Desktop Engine Ready" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Content="Reconnect Engine" Click="OnReconnectEngineClick" />
                    <Button Content="Hide to Tray" Click="OnHideToTrayClick" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main NavigationView Shell -->
        <NavigationView
            x:Name="MainNav"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            PaneDisplayMode="Left"
            OpenPaneLength="245"
            SelectionChanged="OnNavigationSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="NavCompressItem" Tag="CompressBatch" Content="Compress &amp; Batch" IsSelected="True">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xF012;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavBrowserItem" Tag="ArchiveBrowser" Content="Archive Browser">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B7;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavQueueItem" Tag="QueueAndRecovery" Content="Queue &amp; Recovery">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D5;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavHistoryItem" Tag="CompressionHistory" Content="Compression History">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81C;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemSeparator />
                <NavigationViewItemHeader Content="Mutating &amp; Safety-Gated" />
                <NavigationViewItem x:Name="NavStudioItem" Tag="OptimizationStudio" Content="Optimization Studio">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7BA;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid Padding="20,16">
                <!-- ========================================================= -->
                <!-- WORKSPACE 1: COMPRESS & BATCH                             -->
                <!-- ========================================================= -->
                <ScrollViewer x:Name="CompressWorkspacePanel" Visibility="Visible" VerticalScrollBarVisibility="Auto">
                    <Grid ColumnSpacing="16" RowSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="7*" />
                            <ColumnDefinition Width="5*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left Column: Drag-Drop Zone + Staged Batch Table -->
                        <StackPanel Grid.Column="0" Spacing="14">
                            <Border
                                x:Name="BatchDropZone"
                                Padding="20"
                                AllowDrop="True"
                                DragOver="OnBatchDragOver"
                                Drop="OnBatchDrop"
                                CornerRadius="8"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="#2DD4BF"
                                BorderThickness="2">
                                <StackPanel Spacing="10">
                                    <TextBlock
                                        Text="Drag &amp; Drop Files or Folders Here"
                                        FontSize="18"
                                        FontWeight="SemiBold" />
                                    <TextBlock
                                        Text="Multi-window Shannon entropy, magic-byte container routing, and SHA-256 exact duplicate detection run automatically before compression."
                                        TextWrapping="Wrap"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="Add Files…" FontWeight="SemiBold" Click="OnAddFilesClick" />
                                        <Button Content="Add Folder…" Click="OnAddFolderClick" />
                                        <Button Content="Remove Selected" Click="OnRemoveSelectedStagedFileClick" />
                                        <Button Content="Clear Batch" Click="OnClearBatchClick" />
                                    </StackPanel>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox
                                            x:Name="QuickStagePathBox"
                                            Grid.Column="0"
                                            PlaceholderText="Or paste a file or folder path directly…" />
                                        <Button Grid.Column="1" Content="Stage Path" Click="OnStagePathClick" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border
                                Padding="14"
                                CornerRadius="8"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                                <StackPanel Spacing="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Staged Batch &amp; Per-File Strategy Routing" FontSize="15" FontWeight="SemiBold" />
                                        <TextBlock
                                            x:Name="CompressStatusSubtitleText"
                                            Grid.Column="1"
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="0 files staged" />
                                    </Grid>

                                    <Grid Padding="4,4" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20*" />
                                            <ColumnDefinition Width="75" />
                                            <ColumnDefinition Width="16*" />
                                            <ColumnDefinition Width="12*" />
                                            <ColumnDefinition Width="140" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="File / Relative Path" FontWeight="SemiBold" FontSize="12" />
                                        <TextBlock Grid.Column="1" Text="Entropy" FontWeight="SemiBold" FontSize="12" />
                                        <TextBlock Grid.Column="2" Text="Chosen Strategy" FontWeight="SemiBold" FontSize="12" />
                                        <TextBlock Grid.Column="3" Text="Dedup Status" FontWeight="SemiBold" FontSize="12" />
                                        <TextBlock Grid.Column="4" Text="Before → Est." FontWeight="SemiBold" FontSize="12" />
                                    </Grid>

                                    <ListView
                                        x:Name="StagedFilesList"
                                        MaxHeight="380"
                                        SelectionMode="Single">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="local:StagedFileRow">
                                                <StackPanel Padding="0,6" Spacing="2">
                                                    <Grid ColumnSpacing="10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="20*" />
                                                            <ColumnDefinition Width="75" />
                                                            <ColumnDefinition Width="16*" />
                                                            <ColumnDefinition Width="12*" />
                                                            <ColumnDefinition Width="140" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{x:Bind RelativePath}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                                                        <TextBlock Grid.Column="1" Text="{x:Bind EntropyFormatted}" FontSize="12" />
                                                        <TextBlock Grid.Column="2" Text="{x:Bind SelectedStrategy}" TextTrimming="CharacterEllipsis" FontSize="12" />
                                                        <TextBlock Grid.Column="3" Text="{x:Bind DuplicateBadgeText}" TextTrimming="CharacterEllipsis" FontSize="12" />
                                                        <TextBlock Grid.Column="4" Text="{x:Bind BeforeToAfterFormatted}" FontSize="12" />
                                                    </Grid>
                                                    <TextBlock
                                                        Text="{x:Bind StrategyJustification}"
                                                        FontSize="11"
                                                        TextWrapping="Wrap"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Right Column: Lossless Profile + Strategy Justification + Destination Manager -->
                        <StackPanel Grid.Column="1" Spacing="14">
                            <!-- Lossless Profile Selector -->
                            <Border
                                Padding="16"
                                CornerRadius="8"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                                <StackPanel Spacing="10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Lossless Profile Selector" FontSize="15" FontWeight="SemiBold" />
                                        <Border
                                            Grid.Column="1"
                                            Padding="8,3"
                                            CornerRadius="10"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            BorderBrush="#16A34A"
                                            BorderThickness="1">
                                            <TextBlock Text="100% Bit-Exact Lossless" FontSize="11" FontWeight="SemiBold" />
                                        </Border>
                                    </Grid>

                                    <ComboBox
                                        x:Name="LosslessProfileCombo"
                                        HorizontalAlignment="Stretch"
                                        SelectionChanged="OnLosslessProfileChanged">
                                        <ComboBoxItem Content="Instant" Tag="Instant" />
                                        <ComboBoxItem Content="Balanced" Tag="Balanced" />
                                        <ComboBoxItem Content="Archive" Tag="Archive" />
                                        <ComboBoxItem Content="Tiny" Tag="Tiny" />
                                        <ComboBoxItem Content="Laboratory" Tag="Laboratory" />
                                    </ComboBox>

                                    <TextBlock
                                        x:Name="ProfileDescriptionText"
                                        FontSize="12"
                                        TextWrapping="Wrap"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock
                                        x:Name="ProfileSlaMetricsText"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Live Strategy Justification Panel -->
                            <Border
                                Padding="16"
                                CornerRadius="8"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Strategy Justification Panel" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock x:Name="StrategyHeadlineText" FontSize="12" TextWrapping="Wrap" />
                                    <Border
                                        Padding="8,5"
                                        CornerRadius="6"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                        <TextBlock x:Name="BatchDuplicateSummaryTextBlock" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    </Border>
                                    <TextBlock
                                        x:Name="RejectedAlternativesText"
                                        FontSize="12"
                                        TextWrapping="Wrap"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                    <ListView x:Name="CategoryBreakdownList" MaxHeight="180" SelectionMode="None">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="local:CategoryBreakdownRow">
                                                <StackPanel Padding="0,4" Spacing="2">
                                                    <TextBlock Text="{x:Bind SummaryLine}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    <TextBlock Text="{x:Bind WhySelected}" FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </Border>

                            <!-- Destination Manager & Before/After Size Comparison -->
                            <Border
                                Padding="16"
                                CornerRadius="8"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Destination Manager &amp; Size Comparison" FontSize="15" FontWeight="SemiBold" />

                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox
                                            x:Name="CompressDestFolderBox"
                                            Grid.Column="0"
                                            Header="Target Destination Folder"
                                            TextChanged="OnCompressDestChanged" />
                                        <Button
                                            Grid.Column="1"
                                            VerticalAlignment="Bottom"
                                            Content="Browse…"
                                            Click="OnPickCompressDestinationClick" />
                                    </Grid>

                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox
                                            x:Name="ArchiveFileNameBox"
                                            Grid.Column="0"
                                            Header="Archive Filename (.ucx)"
                                            Text="Archive.ucx"
                                            TextChanged="OnArchiveFileNameChanged" />
                                        <ComboBox
                                            x:Name="CompressConflictModeCombo"
                                            Grid.Column="1"
                                            Header="Conflict Policy"
                                            HorizontalAlignment="Stretch"
                                            SelectedIndex="0"
                                            SelectionChanged="OnCompressConflictChanged">
                                            <ComboBoxItem Content="Rename" Tag="Rename" />
                                            <ComboBoxItem Content="Overwrite" Tag="Overwrite" />
                                            <ComboBoxItem Content="Skip" Tag="Skip" />
                                        </ComboBox>
                                    </Grid>

                                    <!-- Visual Before vs Estimated After Size Comparison Bar -->
                                    <Border
                                        Padding="10"
                                        CornerRadius="6"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                        <StackPanel Spacing="6">
                                            <TextBlock x:Name="BeforeAfterHeadlineText" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="Before (Original Input)" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <Border Height="10" Width="320" HorizontalAlignment="Left" CornerRadius="5" Background="{ThemeResource CardStrokeColorDefaultBrush}" />
                                                <TextBlock Text="Estimated After (Lossless .UCX)" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <Border x:Name="EstimatedAfterBarFill" Height="10" Width="0" HorizontalAlignment="Left" CornerRadius="5" Background="#16A34A" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <InfoBar
                                        x:Name="DiskSpaceInfoBar"
                                        IsOpen="True"
                                        IsClosable="False"
                                        Severity="Informational"
                                        Title="Disk Space Pre-Check"
                                        Message="Evaluating destination capacity…" />

                                    <InfoBar
                                        x:Name="CompressErrorInfoBar"
                                        IsOpen="False"
                                        IsClosable="True"
                                        Severity="Error" />

                                    <Button
                                        x:Name="StartBatchCompressButton"
                                        HorizontalAlignment="Stretch"
                                        FontWeight="SemiBold"
                                        Content="Compress Batch to Lossless .UCX Archive"
                                        Click="OnStartBatchCompressClick" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- ========================================================= -->
                <!-- WORKSPACE 2: ARCHIVE BROWSER & SELECTIVE EXTRACTOR        -->
                <!-- ========================================================= -->
                <Grid x:Name="ArchiveBrowserPanel" Visibility="Collapsed" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Archive Picker + Search & Filter Bar -->
                    <Border
                        Grid.Row="0"
                        Padding="14"
                        CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                        <StackPanel Spacing="10">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    x:Name="ArchivePathBox"
                                    Grid.Column="0"
                                    PlaceholderText="Select or enter a .ucx or .zip archive path…" />
                                <Button Grid.Column="1" Content="Browse Archive…" Click="OnPickArchiveFileClick" />
                                <Button Grid.Column="2" Content="Open Archive" FontWeight="SemiBold" Click="OnOpenArchivePathClick" />
                            </Grid>

                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="2*" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    x:Name="ArchiveSearchBox"
                                    Grid.Column="0"
                                    PlaceholderText="Search file tree by name, path, codec, or SHA-256…"
                                    TextChanged="OnArchiveSearchChanged" />
                                <ComboBox
                                    x:Name="ArchiveCodecFilterCombo"
                                    Grid.Column="1"
                                    HorizontalAlignment="Stretch"
                                    PlaceholderText="Filter by Strategy/Codec"
                                    SelectionChanged="OnArchiveCodecFilterChanged" />
                                <TextBlock
                                    x:Name="ArchiveManifestSummaryText"
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    TextTrimming="CharacterEllipsis"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="No archive loaded." />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Searchable / Filterable Archive Tree Table (Native Multi-Select Checkboxes) -->
                    <Border
                        Grid.Row="1"
                        Padding="12"
                        CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                        <Grid RowSpacing="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Padding="38,4,6,4" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24*" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="85" />
                                    <ColumnDefinition Width="15*" />
                                    <ColumnDefinition Width="14*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Name / Tree Hierarchy" FontWeight="SemiBold" FontSize="12" />
                                <TextBlock Grid.Column="1" Text="Original Size" FontWeight="SemiBold" FontSize="12" />
                                <TextBlock Grid.Column="2" Text="Compressed Size" FontWeight="SemiBold" FontSize="12" />
                                <TextBlock Grid.Column="3" Text="Savings %" FontWeight="SemiBold" FontSize="12" />
                                <TextBlock Grid.Column="4" Text="Strategy / Codec" FontWeight="SemiBold" FontSize="12" />
                                <TextBlock Grid.Column="5" Text="SHA-256 Status" FontWeight="SemiBold" FontSize="12" />
                            </Grid>

                            <ListView
                                x:Name="ArchiveEntriesList"
                                Grid.Row="1"
                                SelectionMode="Multiple"
                                SelectionChanged="OnArchiveEntriesSelectionChanged">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:ArchiveEntryRow">
                                        <Grid Padding="2,4" ColumnSpacing="10" VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24*" />
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="85" />
                                                <ColumnDefinition Width="15*" />
                                                <ColumnDefinition Width="14*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{x:Bind IndentedDisplayName}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{x:Bind OriginalSizeFormatted}" FontSize="12" />
                                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{x:Bind CompressedSizeFormatted}" FontSize="12" />
                                            <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="{x:Bind SavingsFormatted}" FontSize="12" />
                                            <TextBlock Grid.Column="4" VerticalAlignment="Center" Text="{x:Bind StrategyCodec}" TextTrimming="CharacterEllipsis" FontSize="12" />
                                            <TextBlock Grid.Column="5" VerticalAlignment="Center" Text="{x:Bind Sha256StatusDisplay}" TextTrimming="CharacterEllipsis" FontSize="12" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>

                    <!-- Selective Extraction & Integrity Footer -->
                    <Border
                        Grid.Row="2"
                        Padding="14"
                        CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                        <StackPanel Spacing="10">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="140" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="Select All Visible" Click="OnSelectAllArchiveEntriesClick" />
                                <Button Grid.Column="1" Content="Clear Selection" Click="OnClearArchiveSelectionClick" />
                                <TextBlock
                                    x:Name="ArchiveSelectionSummaryText"
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Text="0 files selected" />
                                <TextBox
                                    x:Name="ExtractDestFolderBox"
                                    Grid.Column="3"
                                    PlaceholderText="Extraction destination folder…"
                                    TextChanged="OnExtractDestFolderChanged" />
                                <Button Grid.Column="4" Content="Browse…" Click="OnPickExtractDestinationClick" />
                                <ComboBox
                                    x:Name="ExtractConflictModeCombo"
                                    Grid.Column="5"
                                    HorizontalAlignment="Stretch"
                                    SelectedIndex="0"
                                    SelectionChanged="OnExtractConflictModeChanged">
                                    <ComboBoxItem Content="Rename" Tag="Rename" />
                                    <ComboBoxItem Content="Overwrite" Tag="Overwrite" />
                                    <ComboBoxItem Content="Skip" Tag="Skip" />
                                </ComboBox>
                            </Grid>

                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    x:Name="ArchiveOperationStatusText"
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    TextWrapping="Wrap" />
                                <Button x:Name="VerifyArchiveButton" Grid.Column="1" Content="Verify Archive" Click="OnVerifyArchiveClick" />
                                <Button x:Name="ExtractSelectedButton" Grid.Column="2" FontWeight="SemiBold" Content="Extract Selected" Click="OnExtractSelectedClick" />
                                <Button x:Name="ExtractAllButton" Grid.Column="3" Content="Extract All" Click="OnExtractAllClick" />
                            </Grid>

                            <InfoBar
                                x:Name="ArchiveErrorInfoBar"
                                IsOpen="False"
                                IsClosable="True"
                                Severity="Error" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ========================================================= -->
                <!-- WORKSPACE 3: QUEUE & CRASH RECOVERY CENTER                -->
                <!-- ========================================================= -->
                <Grid x:Name="QueueWorkspacePanel" Visibility="Collapsed" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Crash Recovery Banner -->
                    <Border
                        x:Name="CrashRecoveryBanner"
                        Grid.Row="0"
                        Visibility="Collapsed"
                        Padding="16"
                        CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="#D97706"
                        BorderThickness="2">
                        <StackPanel Spacing="8">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock x:Name="CrashRecoveryBannerTitleText" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock x:Name="CrashRecoveryBannerDetailText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Resume Selected" FontWeight="SemiBold" Click="OnResumeSelectedInterruptedClick" />
                                <Button Grid.Column="2" Content="Discard Selected Temp" Click="OnDiscardSelectedInterruptedClick" />
                                <Button Grid.Column="3" Content="Resume All" Click="OnResumeAllInterruptedClick" />
                                <Button Grid.Column="4" Content="Discard All Temp" Click="OnDiscardAllInterruptedClick" />
                            </Grid>

                            <ListView x:Name="InterruptedRecoveryList" MaxHeight="160" SelectionMode="Single">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:InterruptedRecoveryRow">
                                        <TextBlock Padding="2,4" Text="{x:Bind RecoverySummary}" TextWrapping="Wrap" FontSize="12" />
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>

                    <!-- Global & Selected Job Controls Toolbar -->
                    <Border
                        Grid.Row="1"
                        Padding="14,10"
                        CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Active &amp; Queued Jobs" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock x:Name="QueueSummaryCounterText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Priority ↑" Click="OnSelectedJobMoveUpClick" />
                            <Button Grid.Column="2" Content="Priority ↓" Click="OnSelectedJobMoveDownClick" />
                            <Button x:Name="PauseSelectedJobButton" Grid.Column="3" Content="Pause" Click="OnSelectedJobPauseClick" />
                            <Button x:Name="ResumeSelectedJobButton" Grid.Column="4" Content="Resume" Click="OnSelectedJobResumeClick" />
                            <Button x:Name="CancelSelectedJobButton" Grid.Column="5" Content="Cancel" Click="OnSelectedJobCancelClick" />
                            <Button Grid.Column="6" Content="Pause All" Click="OnPauseAllClick" />
                            <Button Grid.Column="7" Content="Resume All" Click="OnResumeAllClick" />
                            <Button Grid.Column="8" Content="Reconnect" Click="OnReconnectEngineClick" />
                        </Grid>
                    </Border>

                    <!-- Queue Jobs List with Progress, MB/s, ETA, Priority & Actionable Error Cards -->
                    <ListView
                        x:Name="QueueJobsList"
                        Grid.Row="2"
                        SelectionMode="Single"
                        SelectionChanged="OnQueueJobSelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:QueueJobRow">
                                <Border
                                    Margin="0,4"
                                    Padding="14"
                                    CornerRadius="8"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                    <StackPanel Spacing="8">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Spacing="2">
                                                <TextBlock Text="{x:Bind JobTitle}" FontWeight="SemiBold" FontSize="14" />
                                                <TextBlock Text="{x:Bind InputSummary}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                            <Border Grid.Column="1" Padding="8,3" CornerRadius="6" VerticalAlignment="Center" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                                <TextBlock Text="{x:Bind PriorityLabel}" FontSize="12" FontWeight="SemiBold" />
                                            </Border>
                                            <Border Grid.Column="2" Padding="8,3" CornerRadius="6" VerticalAlignment="Center" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                                <TextBlock Text="{x:Bind ProfileName}" FontSize="12" />
                                            </Border>
                                            <Border Grid.Column="3" Padding="8,3" CornerRadius="6" VerticalAlignment="Center" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                                <TextBlock Text="{x:Bind StateBadgeText}" FontSize="12" FontWeight="SemiBold" />
                                            </Border>
                                        </Grid>

                                        <ProgressBar
                                            Minimum="0"
                                            Maximum="100"
                                            Value="{x:Bind ProgressPercent}" />

                                        <TextBlock
                                            Text="{x:Bind MetricsSummaryLine}"
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                        <TextBlock
                                            Text="{x:Bind ErrorDetailBlock}"
                                            FontSize="12"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <!-- ========================================================= -->
                <!-- WORKSPACE 4: COMPRESSION HISTORY VIEW                     -->
                <!-- ========================================================= -->
                <Grid x:Name="HistoryWorkspacePanel" Visibility="Collapsed" RowSpacing="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Cumulative KPI Strip -->
                    <Grid Grid.Row="0" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Padding="14" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Cumulative Space Saved" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="HistoryKpiSavedText" FontSize="22" FontWeight="SemiBold" Text="0 B" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Padding="14" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Average Space Reduction" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="HistoryKpiAvgRatioText" FontSize="22" FontWeight="SemiBold" Text="0.0%" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Padding="14" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Completed Jobs" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="HistoryKpiTotalJobsText" FontSize="22" FontWeight="SemiBold" Text="0 job(s)" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="3" Padding="14" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Integrity Verified" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="HistoryKpiVerifiedText" FontSize="22" FontWeight="SemiBold" Text="0 bit-exact SHA-256" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- History Search, Filter & Actions -->
                    <Grid Grid.Row="1" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            x:Name="HistorySearchBox"
                            Grid.Column="0"
                            PlaceholderText="Search history by archive name, strategy, profile, or destination…"
                            TextChanged="OnHistorySearchChanged" />
                        <ComboBox
                            x:Name="HistoryProfileFilterCombo"
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            SelectedIndex="0"
                            SelectionChanged="OnHistoryProfileFilterChanged">
                            <ComboBoxItem Content="All" />
                            <ComboBoxItem Content="Instant" />
                            <ComboBoxItem Content="Balanced" />
                            <ComboBoxItem Content="Archive" />
                            <ComboBoxItem Content="Tiny" />
                            <ComboBoxItem Content="Laboratory" />
                            <ComboBoxItem Content="Optimization Studio" />
                        </ComboBox>
                        <Button Grid.Column="2" Content="Open Folder" Click="OnHistoryOpenFolderClick" />
                        <Button Grid.Column="3" Content="Extract / Browse" FontWeight="SemiBold" Click="OnHistoryExtractClick" />
                    </Grid>

                    <!-- History Table -->
                    <Border
                        Grid.Row="2"
                        Padding="12"
                        CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                        <ListView x:Name="HistoryRecordsList" SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:HistoryRecordRow">
                                    <Grid Padding="4,8" ColumnSpacing="12" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="125" />
                                            <ColumnDefinition Width="16*" />
                                            <ColumnDefinition Width="13*" />
                                            <ColumnDefinition Width="20*" />
                                            <ColumnDefinition Width="135" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{x:Bind CompletedAtFormatted}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind ArchiveName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind SourceSummary}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind ProfileName}" FontSize="12" FontWeight="SemiBold" />
                                            <TextBlock Text="{x:Bind StrategySummary}" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="{x:Bind BeforeAfterComparisonText}" FontSize="12" TextWrapping="Wrap" />
                                        <TextBlock Grid.Column="4" VerticalAlignment="Center" Text="{x:Bind VerificationBadge}" FontSize="12" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>
                </Grid>

                <!-- ========================================================= -->
                <!-- WORKSPACE 5: SAFETY-SEPARATED OPTIMIZATION STUDIO         -->
                <!-- ========================================================= -->
                <ScrollViewer x:Name="OptimizationStudioPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="14">
                        <!-- Mandatory Safety Separation Banner -->
                        <Border
                            Padding="16"
                            CornerRadius="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="#D97706"
                            BorderThickness="2">
                            <StackPanel Spacing="4">
                                <TextBlock
                                    Text="SAFETY-SEPARATED OPTIMIZATION &amp; DATA HYGIENE STUDIO (NON-BIT-EXACT)"
                                    FontSize="16"
                                    FontWeight="SemiBold" />
                                <TextBlock
                                    Text="Lossless Compression lives exclusively in 'Compress &amp; Batch'. Operations in this studio intentionally alter perceptual fidelity, container format, or embedded metadata and require explicit informed consent. Original files are preserved untouched by default."
                                    TextWrapping="Wrap"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Left: Sub-Mode Selection + File Staging + Impact Preview -->
                            <StackPanel Grid.Column="0" Spacing="12">
                                <Border Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="1. Choose Mutating Sub-Mode &amp; Target Preset" FontSize="15" FontWeight="SemiBold" />
                                        <ComboBox
                                            x:Name="StudioSubModeCombo"
                                            Header="Operation Sub-Mode"
                                            HorizontalAlignment="Stretch"
                                            SelectedIndex="0"
                                            SelectionChanged="OnStudioSubModeChanged">
                                            <ComboBoxItem Content="Lossy Optimization (Perceptual Size Reduction)" Tag="LossyOptimization" />
                                            <ComboBoxItem Content="Format Conversion (Container Transcoding)" Tag="FormatConversion" />
                                            <ComboBoxItem Content="Metadata / Data Removal (EXIF, GPS &amp; Padding Hygiene)" Tag="DataRemoval" />
                                        </ComboBox>

                                        <ComboBox
                                            x:Name="StudioTargetPresetCombo"
                                            Header="Transform Preset"
                                            HorizontalAlignment="Stretch"
                                            SelectionChanged="OnStudioTargetPresetChanged" />

                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Content="Select Input Files…" FontWeight="SemiBold" Click="OnStudioAddFilesClick" />
                                            <Button Content="Clear Studio Files" Click="OnStudioClearFilesClick" />
                                        </StackPanel>

                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="StudioQuickPathBox" Grid.Column="0" PlaceholderText="Or enter file path for Studio preview…" />
                                            <Button Grid.Column="1" Content="Add File" Click="OnStudioAddPathClick" />
                                        </Grid>

                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox
                                                x:Name="StudioOutputDirBox"
                                                Grid.Column="0"
                                                Header="Output Directory for Transformed Copies"
                                                TextChanged="OnStudioOutputDirChanged" />
                                            <Button Grid.Column="1" VerticalAlignment="Bottom" Content="Browse…" Click="OnStudioPickOutputDirClick" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Impact & Itemized Preview Card -->
                                <Border Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="2. Impact &amp; Itemized Preview Summary" FontSize="15" FontWeight="SemiBold" />
                                        <TextBlock x:Name="StudioPreviewHeadlineText" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock x:Name="StudioFidelityImpactText" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <ListView x:Name="StudioItemizedPreviewList" MaxHeight="180" SelectionMode="None" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Right: Original Preservation Safety Toggle + Explicit Consent Gate -->
                            <StackPanel Grid.Column="1" Spacing="12">
                                <Border Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                    <StackPanel Spacing="12">
                                        <TextBlock Text="3. Original Preservation &amp; Explicit Consent Gate" FontSize="15" FontWeight="SemiBold" />

                                        <ToggleSwitch
                                            x:Name="PreserveOriginalToggle"
                                            Header="Preserve Original File (Safety Lock — Default Enabled)"
                                            OnContent="Original files kept 100% untouched; outputs written to separate files"
                                            OffContent="WARNING: Originals will be overwritten in place"
                                            IsOn="True"
                                            Toggled="OnPreserveOriginalToggled" />

                                        <Border Padding="10" CornerRadius="6" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                            <TextBlock x:Name="StudioPreservationBadgeText" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        </Border>

                                        <CheckBox
                                            x:Name="ConsentNonBitExactCheck"
                                            Click="OnStudioConsentChanged"
                                            Content="I understand this operation modifies data, container layout, or metadata and is NOT bit-exact lossless compression." />

                                        <CheckBox
                                            x:Name="ConsentPreviewReviewedCheck"
                                            Click="OnStudioConsentChanged"
                                            Content="I have reviewed the itemized Impact &amp; Preview summary and target output folder." />

                                        <CheckBox
                                            x:Name="ConsentDestructiveReplaceCheck"
                                            Visibility="Collapsed"
                                            Click="OnStudioConsentChanged"
                                            Content="DESTRUCTIVE OVERRIDE: I explicitly confirm replacing my original source files on disk." />

                                        <InfoBar
                                            x:Name="StudioGateInfoBar"
                                            IsOpen="True"
                                            IsClosable="False"
                                            Severity="Warning"
                                            Title="Consent Gate"
                                            Message="Stage files and complete explicit consent checks to unlock execution." />

                                        <InfoBar
                                            x:Name="StudioErrorInfoBar"
                                            IsOpen="False"
                                            IsClosable="True"
                                            Severity="Error" />

                                        <Button
                                            x:Name="ExecuteStudioButton"
                                            HorizontalAlignment="Stretch"
                                            IsEnabled="False"
                                            FontWeight="SemiBold"
                                            Content="Execute Consented Studio Operation"
                                            Click="OnExecuteStudioOperationClick" />

                                        <TextBlock
                                            x:Name="StudioExecutionStatusText"
                                            FontSize="12"
                                            TextWrapping="Wrap"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </NavigationView>

        <!-- Bottom Status Strip & System Tray Icon -->
        <Border
            Grid.Row="2"
            Padding="16,8"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="FooterStatusText"
                    Grid.Column="0"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Ready · Lossless mode active" />
                <TextBlock
                    x:Name="FooterSavedKpiText"
                    Grid.Column="1"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Text="Cumulative Space Saved: 0 B" />
            </Grid>
        </Border>

        <tb:TaskbarIcon
            x:Name="TrayIcon"
            IconSource="/Assets/TrayIcon.png"
            ToolTipText="UltraCompress Desktop — Ready"
            MenuActivation="RightClick"
            LeftClickCommand="{x:Bind ShowDesktopWindowCommand}">
            <tb:TaskbarIcon.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Text="Open UltraCompress Desktop" Click="OnOpenDesktopFromTray" />
                    <MenuFlyoutItem Text="Compress &amp; Batch…" Click="OnOpenCompressFromTray" />
                    <MenuFlyoutItem Text="Archive Browser…" Click="OnOpenBrowserFromTray" />
                    <MenuFlyoutItem Text="Queue &amp; Recovery" Click="OnOpenQueueFromTray" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Pause all jobs" Click="OnPauseAllClick" />
                    <MenuFlyoutItem Text="Resume all jobs" Click="OnResumeAllClick" />
                    <MenuFlyoutItem Text="Reconnect to engine" Click="OnReconnectEngineClick" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Exit UltraCompress" Click="OnExitApplicationClick" />
                </MenuFlyout>
            </tb:TaskbarIcon.ContextFlyout>
        </tb:TaskbarIcon>
    </Grid>
</Window>
